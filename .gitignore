# Dependencies and generated output
node_modules/
/dist/
/.explorer-build-*/
/.tmp/
/.build-version.lock
/build-version.json.tmp-*
.cache/
.vite/
*.tsbuildinfo
coverage/
.nyc_output/
*.lcov

# Local configuration and credentials; keep the portable example
.env
.env.*
!.env.template
!.env.example
/.aws/
/.codex/
/.agents/

# Canonical databases stay outside Git; maintenance outputs live under .cache/.
# public/map-data is the distributable dataset, included with the source for Pages.
/data/
/data_old/
*.db
*.db.wal
*.duck
*.duckdb
/_site/

# Old local recovery copies. Use Git for new source changes.
/.archive/
/backups/
*.bak
*.orig
*~

# Logs and process state
logs/
*.log
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local editor and OS state
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Optional local IDE state inherited from the former client directory
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
